# WeatherGPT Environment Configuration Template
# Copy this file to .env and configure your keys

# OpenWeather API Key (Get free key at https://openweathermap.org/api)
# Note: WeatherGPT automatically falls back to Open-Meteo if key is left empty
OPENWEATHER_API_KEY=

# OpenAI API Key (Optional for advanced GPT query understanding)
# Note: WeatherGPT includes a native heuristic/NLU engine when key is empty
OPENAI_API_KEY=

# Database Connection (Default: SQLite; supports PostgreSQL)
DATABASE_URL=sqlite:///./weathergpt.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/weathergpt

# Numerical Weather Prediction (NWP) Endpoints (Leave blank for 'Provider not configured')
GFS_NWP_ENDPOINT=
WRF_MODEL_ENDPOINT=

# Application Settings
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

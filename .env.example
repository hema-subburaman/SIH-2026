# WeatherGPT Environment Configuration Template
# Copy this file to .env and configure your keys

# OpenWeather API Key (Get free key at https://openweathermap.org/api)
# Note: WeatherGPT automatically falls back to Open-Meteo if key is left empty
OPENWEATHER_API_KEY=

# OpenAI API Key (Optional for advanced GPT query understanding)
# Note: WeatherGPT includes a native multilingual heuristic/NLU engine when key is empty
OPENAI_API_KEY=

# Database Connection (Default: SQLite for development; supports PostgreSQL for production)
DATABASE_URL=sqlite:///./weathergpt.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/weathergpt

# Numerical Weather Prediction (NWP) Configuration
# NOAA GFS: Set GFS_NOMADS_ENABLED=true for live Open Data, or configure custom endpoint/file
GFS_NOMADS_ENABLED=true
GFS_NWP_ENDPOINT=
GFS_FILE_PATH=

# WRF-ARW Meso-scale Simulation: Configure cluster endpoint or local NetCDF storage path
WRF_MODEL_ENDPOINT=
WRF_NETCDF_PATH=

# Alert Polling & Monitoring Configuration
ALERT_POLL_INTERVAL_SECONDS=300
MONITORED_ALERT_CITIES=["Chennai","Bengaluru","Mumbai","Delhi","Kolkata","Hyderabad"]

# Application Settings
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

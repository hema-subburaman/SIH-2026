# Frontend Environment Variables Template for WeatherGPT
#
# Production (e.g. deployed on Render):
# Set these in the Render Dashboard under Environment Variables:
#
# VITE_API_BASE_URL=https://sih-2026-backend-kdio.onrender.com/api/v1
# VITE_WS_URL=wss://sih-2026-backend-kdio.onrender.com/ws/alerts
#
# Local Development (defaults used automatically if left unset):
# VITE_API_BASE_URL=/api/v1
# VITE_BACKEND_PORT=8000
